{
  "name": "ctrlaltbot",
  "version": "1.1.1",
  "description": "Discord bot for ctrl alt doc documentation sites, running as a Cloudflare Worker.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    }
  },
  "bin": {
    "ctrlaltbot-register": "bin/ctrlaltbot-register.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "release": "npm run build && npm test && node scripts/create-release.mjs",
    "dev": "wrangler dev",
    "register": "node dist/register-commands.js",
    "register:dev": "tsx src/register-commands.ts"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "cloudflare-workers",
    "documentation",
    "ctrl-alt-doc"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260915.1": true
  }
}
