{
  "name": "ctrlaltbot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "vars": {
    "CAD_BASE_URL": "https://your-docs.example.com",
    "DISCORD_CLIENT_ID": "YOUR_DISCORD_APPLICATION_ID"
  },
  // Stores per-server settings. Created automatically on first deploy.
  "kv_namespaces": [
    {
      "binding": "BRAND_SETTINGS"
    }
  ],
  // Keeps the slash commands up to date after each update.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
