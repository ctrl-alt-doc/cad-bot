// Development configuration for working on the bot itself.
// To run your own bot, use the template in `template/` instead.
{
  "name": "ctrlaltbot-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  // Lets the bot reach a docs site hosted as a Worker in the same Cloudflare
  // account, which Cloudflare otherwise blocks with a 404 (error 1042).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "vars": {
    "CAD_BASE_URL": "https://your-docs.example.com",
    "DISCORD_CLIENT_ID": "YOUR_DISCORD_APPLICATION_ID"
  },
  // Created automatically on first deploy.
  "kv_namespaces": [
    {
      "binding": "BRAND_SETTINGS"
    }
  ],
  // Re-registers slash commands hourly if their definitions have changed.
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
